{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": true,
    "lib": [
      "ES2022"
    ],
    "typeRoots": [],
    "types": [],
    "baseUrl": ".",
    "paths": {
      "@minecraft/*": [
        "node_modules/@minecraft/*"
      ]
    }
  },
  "include": [
    "../src/scripts/**/*.js",
    "types/globals.d.ts"
  ]
}