{
 "format_version": "1.10.0",
 "particle_effect": {
  "description": {
   "identifier": "gun:muzzle_smoke",
   "basic_render_parameters": {
    "material": "particles_blend",
    "texture": "textures/gun/particles"
   }
  },
  "components": {
   "minecraft:emitter_initialization": {
    "creation_expression": "v.dir ?? { v.dir.x = 0.0; v.dir.y = 1.0; v.dir.z = 0.0; };v.normal ?? { v.normal.x = 0.0; v.normal.y = 1.0; v.normal.z = 0.0; };v.color ?? { v.color.r = 1.0; v.color.g = 1.0; v.color.b = 1.0; };v.len ?? { v.len = 8.0; };v.size ?? { v.size = 1.0; };"
   },
   "minecraft:emitter_lifetime_once": {
    "active_time": 0.05
   },
   "minecraft:emitter_rate_instant": {
    "num_particles": "2 + v.size * 2"
   },
   "minecraft:emitter_shape_point": {
    "offset": [
     0,
     0,
     0
    ],
    "direction": [
     "v.dir.x + math.random(-0.4, 0.4)",
     "v.dir.y + math.random(-0.2, 0.6)",
     "v.dir.z + math.random(-0.4, 0.4)"
    ]
   },
   "minecraft:particle_initial_speed": "math.random(0.4, 1.4)",
   "minecraft:particle_motion_dynamic": {
    "linear_acceleration": [
     0,
     0.35,
     0
    ],
    "linear_drag_coefficient": 2.2
   },
   "minecraft:particle_lifetime_expression": {
    "max_lifetime": "0.7 + v.particle_random_2 * 0.6"
   },
   "minecraft:particle_appearance_billboard": {
    "size": [
     "0.18 + v.particle_age * 0.5",
     "0.18 + v.particle_age * 0.5"
    ],
    "facing_camera_mode": "rotate_xyz",
    "uv": {
     "texture_width": 128,
     "texture_height": 128,
     "uv": [
      "(0 + math.floor(v.particle_random_3 * 4)) * 16",
      16
     ],
     "uv_size": [
      16,
      16
     ]
    }
   },
   "minecraft:particle_initial_spin": {
    "rotation": "v.particle_random_4 * 360",
    "rotation_rate": "math.random(-40, 40)"
   },
   "minecraft:particle_appearance_lighting": {},
   "minecraft:particle_appearance_tinting": {
    "color": {
     "gradient": {
      "0.0": [
       0.8,
       0.8,
       0.8,
       0.45
      ],
      "1.0": [
       0.7,
       0.7,
       0.7,
       0
      ]
     },
     "interpolant": "v.particle_age / v.particle_lifetime"
    }
   }
  }
 }
}