{
  "format_version": "1.26.10",
  "particle_effect": {
    "description": {
      "identifier": "arsenal:explosion",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/arsenal_particles"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": "12 + (v.power ?? 3) * 6"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_sphere": {
        "radius": "(v.power ?? 3) * 0.25",
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.25, 0.55)"
      },
      "minecraft:particle_initial_speed": "math.random(2, 5) * (v.power ?? 3) * 0.5",
      "minecraft:particle_motion_dynamic": {
        "linear_drag_coefficient": 4.0
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.6 + v.particle_age * 2.0) * (v.power ?? 3) * 0.25",
          "(0.6 + v.particle_age * 2.0) * (v.power ?? 3) * 0.25"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 64,
          "texture_height": 64,
          "flipbook": {
            "base_UV": [
              0,
              16
            ],
            "size_UV": [
              8,
              8
            ],
            "step_UV": [
              8,
              0
            ],
            "frames_per_second": 10,
            "max_frame": 4,
            "stretch_to_lifetime": true,
            "loop": false
          }
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "gradient": {
            "0.0": [
              1.0,
              0.95,
              0.7,
              1.0
            ],
            "0.4": [
              1.0,
              0.55,
              0.15,
              1.0
            ],
            "1.0": [
              0.3,
              0.1,
              0.05,
              0.0
            ]
          },
          "interpolant": "v.particle_age / v.particle_lifetime"
        }
      }
    }
  }
}