{
  "format_version": "1.26.10",
  "particle_effect": {
    "description": {
      "identifier": "arsenal:bullet_streak",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/arsenal_particles"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.01
      },
      "minecraft:emitter_shape_point": {
        "direction": [
          "v.tracer.direction_x",
          "v.tracer.direction_y",
          "v.tracer.direction_z"
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.max(0.04, v.life ?? 0.15)"
      },
      "minecraft:particle_initial_speed": "v.tracer.speed",
      "minecraft:particle_motion_dynamic": {},
      "minecraft:particle_appearance_billboard": {
        "size": [
          "v.width ?? 0.022",
          "math.min(0.9, v.tracer.speed * 0.005)"
        ],
        "facing_camera_mode": "lookat_direction",
        "direction": {
          "mode": "derive_from_velocity",
          "min_speed_threshold": 0.01
        },
        "uv": {
          "texture_width": 64,
          "texture_height": 64,
          "uv": [
            0,
            24
          ],
          "uv_size": [
            8,
            8
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "v.color.r",
          "v.color.g",
          "v.color.b",
          "0.6 * (1.0 - 0.4 * v.particle_age / v.particle_lifetime)"
        ]
      }
    }
  }
}