{
  "format_version": "1.26.10",
  "particle_effect": {
    "description": {
      "identifier": "arsenal:tracer_round",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/arsenal_particles"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.01
      },
      "minecraft:emitter_shape_point": {
        "direction": [
          "v.tracer.direction_x",
          "v.tracer.direction_y",
          "v.tracer.direction_z"
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.max(0.05, v.life ?? 0.2)"
      },
      "minecraft:particle_initial_speed": "v.tracer.speed",
      "minecraft:particle_motion_dynamic": {},
      "minecraft:particle_appearance_billboard": {
        "size": [
          "v.width ?? 0.06",
          "math.min(3.0, v.tracer.speed * 0.022)"
        ],
        "facing_camera_mode": "lookat_direction",
        "direction": {
          "mode": "derive_from_velocity",
          "min_speed_threshold": 0.01
        },
        "uv": {
          "texture_width": 64,
          "texture_height": 64,
          "uv": [
            8,
            24
          ],
          "uv_size": [
            8,
            8
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "math.min(1.0, v.color.r * 0.5 + 0.55)",
          "math.min(1.0, v.color.g * 0.5 + 0.45)",
          "math.min(1.0, v.color.b * 0.5 + 0.4)",
          1.0
        ]
      }
    }
  }
}