{
  "format_version": "1.26.10",
  "particle_effect": {
    "description": {
      "identifier": "arsenal:flame",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/arsenal_particles"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 14
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_point": {
        "direction": [
          "v.aim.direction_x + math.random(-0.12, 0.12)",
          "v.aim.direction_y + math.random(-0.12, 0.12)",
          "v.aim.direction_z + math.random(-0.12, 0.12)"
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.35, 0.6)"
      },
      "minecraft:particle_initial_speed": "v.aim.speed * math.random(0.6, 1.0)",
      "minecraft:particle_motion_dynamic": {
        "linear_drag_coefficient": 2.2,
        "linear_acceleration": [
          0,
          1.5,
          0
        ]
      },
      "minecraft:particle_motion_collision": {
        "collision_radius": 0.1,
        "expire_on_contact": true
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.12 + v.particle_age * 0.9",
          "0.12 + v.particle_age * 0.9"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 64,
          "texture_height": 64,
          "flipbook": {
            "base_UV": [
              0,
              16
            ],
            "size_UV": [
              8,
              8
            ],
            "step_UV": [
              8,
              0
            ],
            "frames_per_second": 8,
            "max_frame": 4,
            "stretch_to_lifetime": true,
            "loop": false
          }
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "gradient": {
            "0.0": [
              1.0,
              0.9,
              0.6,
              1.0
            ],
            "0.5": [
              1.0,
              0.45,
              0.1,
              0.9
            ],
            "1.0": [
              0.3,
              0.1,
              0.05,
              0.0
            ]
          },
          "interpolant": "v.particle_age / v.particle_lifetime"
        }
      }
    }
  }
}